# Chain to keep. The deployment is read from deployments/<chain>.json through @confluere/sdk.
CHAIN_ID=10143
RPC_URL=https://testnet-rpc.monad.xyz
# HyperEVM testnet: CHAIN_ID=998, RPC_URL=https://rpc.hyperliquid-testnet.xyz/evm
# Ethereum Sepolia: CHAIN_ID=11155111. Leave RPC_URL unset for viem's default (thirdweb, full log history, 1,000-block
# getLogs) or use a provider with full log history: the keeper scans PoolCreated from deployBlock on every start, and
# https://ethereum-sepolia-rpc.publicnode.com keeps only about the last 10,000 blocks of logs.
# Hot key that pays gas. Every task is permissionless; this key holds no protocol power.
PRIVATE_KEY=0x...
# Poll interval in ms. Leave unset for the per-chain default: 15000 on HyperEVM (no WebSocket, public RPC allows
# about 100 requests a minute per IP), 6000 on Ethereum (12 s blocks), 3000 elsewhere.
# POLL_MS=3000
# Seconds after a batch boundary before settling, and before a boundary to poke vaults.
SETTLE_DELAY_S=5
# SETTLE_EMPTY=1   # settle every due batch even when one side of the book is empty (default: skip, saves gas)
POKE_LEAD_S=60
# Bids processed per closeWindow call (bounded gas on small-block chains).
CLOSE_MAX_BIDS=16
# Hint HTTP server port (0 disables).
HINT_PORT=8787
# getLogs block range per request. Leave unset to use the chain's public-RPC cap (SDK logRange: Monad 100,
# HyperEVM 1000, Sepolia 1000); a larger value is clamped to that cap.
# LOG_CHUNK=100
