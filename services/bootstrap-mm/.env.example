CHAIN_ID=10143
RPC_URL=https://testnet-rpc.monad.xyz
# Treasury-funded key. The rules below are public; the bot has no protocol power.
PRIVATE_KEY=0x...
# Pools to support: comma separated "poolId:class" where class is pegged or main.
POOLS=0xabc...:pegged,0xdef...:main
# Quote per pool per batch, and in total per pool, in quote base units. The total counts quote paid for fills (plus
# bids still resting); escrow refunded from unfilled bids is withdrawn each round and does not use up the cap.
PER_BATCH_QUOTE=1000000000
TOTAL_QUOTE=50000000000
# Stop after this unix time (blueprint: 8 weeks after launch, or once seats cover every pool).
END_AT=0
# Place this many seconds before each batch boundary.
LEAD_S=90
# Where cumulative spend per pool is kept so the total cap survives restarts. Leave unset for the per-chain default
# bootstrap-mm-state-<CHAIN_ID>.json, so bots on two chains never share one file.
# STATE_FILE=bootstrap-mm-state-10143.json
