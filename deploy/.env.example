# Copy to deploy/.env and edit. deploy/.env is git-ignored.
SITE_DOMAIN=app.confluere.xyz

# compiled into the browser bundle (changing them needs a rebuild)
NEXT_PUBLIC_DEFAULT_CHAIN_ID=998
NEXT_PUBLIC_RPC_URL_998=https://rpcs.chain.link/hyperevm/testnet
NEXT_PUBLIC_RPC_URL_10143=https://testnet-rpc.monad.xyz
NEXT_PUBLIC_RPC_URL_11155111=https://ethereum-sepolia-rpc.publicnode.com
NEXT_PUBLIC_REOWN_PROJECT_ID=

# optional server-side log sources for the chain index, "url|blockRange|concurrency,..." per chain
LOGS_RPC_998=
LOGS_RPC_10143=
# Sepolia: publicnode keeps only ~10,000 blocks of logs, so scan with a full-history source, e.g.
# https://11155111.rpc.thirdweb.com|1000|2 (1,000-block cap) or an archive provider of your own.
LOGS_RPC_11155111=
